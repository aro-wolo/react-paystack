{
	"name": "react-paystack",
	"version": "1.0.0",
	"description": "React components and hooks for integrating Paystack payments.",
	"license": "MIT",
	"author": "Arowolo Abiodun",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/aro-wolo/react-paystack.git"
	},
	"bugs": {
		"url": "https://github.com/aro-wolo/react-paystack/issues"
	},
	"homepage": "https://github.com/aro-wolo/react-paystack#readme",
	"keywords": [
		"react",
		"reactjs",
		"paystack",
		"payments",
		"payment-gateway",
		"typescript"
	],
	"type": "module",
	"main": "./dist/react-paystack.umd.cjs",
	"module": "./dist/react-paystack.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/react-paystack.js",
			"require": "./dist/react-paystack.umd.cjs"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"test": "jest --env=jsdom"
	},
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0"
	},
	"dependencies": {
		"@paystack/inline-js": "^2.23.1"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^26.0.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@typescript-eslint/eslint-plugin": "^8.62.1",
		"@typescript-eslint/parser": "^8.62.1",
		"@vitejs/plugin-react": "^6.0.3",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-react": "^7.37.5",
		"prettier": "^3.9.3",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"typescript": "^6.0.3",
		"vite": "^8.1.0"
	}
}
